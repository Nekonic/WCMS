# WCMS 백엔드(Django) 환경변수. 복사: cp .env.example .env
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# 미지정 시 dev.sqlite3 로 폴백. 개발 PostgreSQL(docker compose up -d):
DATABASE_URL=postgres://wcms:wcms@localhost:5432/wcms

# HTTPS 종료(리버스 프록시) 환경에서 true
DJANGO_COOKIE_SECURE=false
